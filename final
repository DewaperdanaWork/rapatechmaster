<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dework Space - Content Analytics & Team Hub 2026</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { darkMode: 'class', theme: { extend: {} } }
  </script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

  <style>
    .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    .dark ::-webkit-scrollbar-thumb { background: #475569; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    .hidden-tab { display: none !important; }
    .sortable-ghost { opacity: 0.4; background-color: #f8fafc; border: 2px dashed #cbd5e1; }
    .dark .sortable-ghost { background-color: #1e293b; border-color: #475569; }
    
    select { -webkit-appearance: none; -moz-appearance: none; appearance: none; background-image: url("data:image/svg+xml;utf8,<svg fill='black' height='24' viewBox='0 0 24 24' width='24' xmlns='http://www.w3.org/2000/svg'><path d='M7 10l5 5 5-5z'/><path d='M0 0h24v24H0z' fill='none'/></svg>"); background-repeat: no-repeat; background-position-x: 100%; background-position-y: 50%; padding-right: 25px; }
    .dark select { background-image: url("data:image/svg+xml;utf8,<svg fill='white' height='24' viewBox='0 0 24 24' width='24' xmlns='http://www.w3.org/2000/svg'><path d='M7 10l5 5 5-5z'/><path d='M0 0h24v24H0z' fill='none'/></svg>"); }

    @media print {
      body { background: white !important; color: #0f172a !important; }
      body * { visibility: hidden !important; }
      #printable-report-area, #printable-report-area * { visibility: visible !important; }
      #modal-executive-report {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        width: 100% !important;
        background: white !important;
        padding: 0 !important;
        margin: 0 !important;
        display: block !important;
      }
      #printable-report-area {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        width: 100% !important;
        background: white !important;
        color: #0f172a !important;
        box-shadow: none !important;
        border: none !important;
      }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 font-sans antialiased flex h-screen overflow-hidden transition-colors duration-300">

  <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Mobile Header -->
  <div class="md:hidden bg-slate-900 dark:bg-slate-950 text-white border-b border-slate-800 p-4 flex justify-between items-center fixed w-full z-30 shadow-md">
    <div class="font-bold text-xl tracking-wide">Dework<span class="text-blue-500">Space</span></div>
    <div class="flex items-center gap-4">
      <button onclick="toggleDarkMode()" class="text-slate-300 hover:text-white"><i class="fa-solid fa-moon"></i></button>
      <button onclick="toggleSidebar()" class="text-slate-300 hover:text-white"><i class="fa-solid fa-bars text-xl"></i></button>
    </div>
  </div>

  <!-- Sidebar Backdrop for Mobile -->
  <div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-black/50 z-20 hidden md:hidden transition-opacity opacity-0 backdrop-blur-sm"></div>

  <!-- Sidebar -->
  <aside id="sidebar" class="fixed md:static inset-y-0 left-0 z-30 w-64 bg-slate-900 dark:bg-slate-950 text-white flex flex-col shadow-xl transform transition-transform duration-300 -translate-x-full md:translate-x-0 pt-16 md:pt-0">
    <div class="p-6 hidden md:flex justify-between border-b border-slate-800 items-center">
      <div>
        <div class="font-bold text-2xl tracking-wide">Dework<span class="text-blue-500">Space</span></div>
        <p class="text-[11px] text-emerald-400 mt-1 uppercase tracking-wider flex items-center font-semibold" id="storage-status-badge">
          <i class="fa-solid fa-database mr-1.5 text-xs"></i> IndexedDB Active
        </p>
      </div>
      <button onclick="toggleDarkMode()" class="text-slate-400 hover:text-white transition-colors" title="Toggle Dark Mode">
        <i class="fa-solid fa-moon text-lg" id="dark-icon"></i>
      </button>
    </div>
    
    <nav class="flex-1 p-4 space-y-2 overflow-y-auto">
      <button onclick="switchTab('overview')" data-tab="overview" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-lg transition-colors bg-blue-600 text-white shadow-md"><i class="fa-solid fa-table-columns w-5 text-center text-lg"></i><span class="font-medium">Overview</span></button>
      <button onclick="switchTab('vc-summary')" data-tab="vc-summary" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-lg transition-colors text-slate-400 hover:bg-slate-800 hover:text-white"><i class="fa-solid fa-layer-group w-5 text-center text-lg"></i><span class="font-medium text-left">Video & Carousel Summary</span></button>
      <button onclick="switchTab('compare')" data-tab="compare" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-lg transition-colors text-slate-400 hover:bg-slate-800 hover:text-white"><i class="fa-solid fa-code-compare w-5 text-center text-lg"></i><span class="font-medium">Daily Compare</span></button>
      <button onclick="switchTab('analytics')" data-tab="analytics" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-lg transition-colors text-slate-400 hover:bg-slate-800 hover:text-white"><i class="fa-solid fa-chart-pie w-5 text-center text-lg"></i><span class="font-medium">Data Analytics</span></button>
      <button onclick="switchTab('products')" data-tab="products" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-lg transition-colors text-slate-400 hover:bg-slate-800 hover:text-white"><i class="fa-solid fa-bag-shopping w-5 text-center text-lg"></i><span class="font-medium">Produk & Sales</span></button>
      <button onclick="switchTab('todos')" data-tab="todos" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-lg transition-colors text-slate-400 hover:bg-slate-800 hover:text-white"><i class="fa-solid fa-people-group w-5 text-center text-lg"></i><span class="font-medium">Team Workspace</span></button>
      <button onclick="switchTab('content')" data-tab="content" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-lg transition-colors text-slate-400 hover:bg-slate-800 hover:text-white"><i class="fa-solid fa-file-lines w-5 text-center text-lg"></i><span class="font-medium">Content Log</span></button>
    </nav>

    <!-- Team Sync & Workspace Backup Hub -->
    <div class="p-4 border-t border-slate-800 space-y-2 bg-slate-950/60">
      <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider mb-1 flex items-center justify-between">
        <span>Team Data Sharing</span>
        <span class="text-blue-400">Offline/Sync</span>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <button onclick="exportWorkspaceJSON()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold py-2 px-2.5 rounded-lg flex items-center justify-center gap-1.5 transition border border-slate-700 shadow-sm" title="Download backup data untuk tim">
          <i class="fa-solid fa-file-export text-emerald-400"></i> Export
        </button>
        <button onclick="document.getElementById('import-workspace-input').click()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold py-2 px-2.5 rounded-lg flex items-center justify-center gap-1.5 transition border border-slate-700 shadow-sm" title="Muat data dari file rekan tim">
          <i class="fa-solid fa-file-import text-blue-400"></i> Import
        </button>
        <input type="file" id="import-workspace-input" class="hidden" accept=".json" onchange="importWorkspaceJSON(event)">
      </div>
      <div class="pt-2 border-t border-slate-800/80 space-y-1.5">
        <button onclick="openExecutiveReportModal()" class="w-full bg-gradient-to-r from-blue-600/30 to-indigo-600/30 hover:from-blue-600/50 hover:to-indigo-600/50 text-indigo-200 border border-indigo-500/40 text-xs font-bold py-2 px-3 rounded-lg flex items-center justify-center gap-2 transition shadow-xs" title="Buka ringkasan laporan eksekutif siap cetak / PDF">
          <i class="fa-solid fa-file-invoice text-indigo-400"></i> Laporan Eksekutif (PDF)
        </button>
        <button onclick="confirmResetAllToZero()" class="w-full bg-rose-500/10 hover:bg-rose-500/25 text-rose-400 hover:text-rose-300 border border-rose-500/20 text-xs font-semibold py-2 px-3 rounded-lg flex items-center justify-center gap-2 transition" title="Kosongkan semua data ke 0 untuk upload file baru">
          <i class="fa-solid fa-trash-can text-xs"></i> Reset Semua Data ke 0
        </button>
        <button onclick="loadSampleRAPAData()" class="w-full bg-slate-800/60 hover:bg-slate-800 text-slate-400 hover:text-slate-200 border border-slate-700/50 text-[11px] font-medium py-1.5 px-3 rounded-lg flex items-center justify-center gap-2 transition" title="Muat contoh data RAPAtech jika diperlukan">
          <i class="fa-solid fa-rotate text-[10px]"></i> Isi Contoh Data RAPAtech
        </button>
      </div>
    </div>
  </aside>

  <main class="flex-1 p-6 md:p-8 overflow-y-auto w-full h-full pt-20 md:pt-8 relative" id="main-content">
    <div class="max-w-7xl mx-auto">
      
      <!-- TAB: OVERVIEW -->
      <div id="tab-overview" class="tab-content animate-fade-in">
        <header class="mb-8 flex flex-col md:flex-row justify-between md:items-end gap-4">
          <div>
            <h1 class="text-3xl font-bold text-slate-800 dark:text-white">Content & Revenue Overview</h1>
            <p class="text-slate-500 dark:text-slate-400 mt-1">Dashboard analitik terpadu tim kreatif & performa penjualan RAPAtech.</p>
          </div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-300 rounded-lg text-xs font-semibold border border-blue-200 dark:border-blue-800">
              <i class="fa-solid fa-calendar-check"></i> <span id="overview-period-label">Data Kosong (0) - Siap Upload File</span>
            </span>
            <button onclick="openExecutiveReportModal()" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold shadow-sm transition">
              <i class="fa-solid fa-file-pdf"></i> Laporan Eksekutif (PDF)
            </button>
          </div>
        </header>

        <!-- KPI TOP ROW: Reach & Traffic -->
        <h2 class="font-bold text-lg text-slate-700 dark:text-slate-300 mb-4 flex items-center justify-between">
          <span class="flex items-center"><i class="fa-solid fa-photo-film mr-2 text-blue-500"></i> Content Performance Metrics</span>
          <span class="text-xs text-slate-400 font-normal">Real TikTok Analytics Aggregation</span>
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3.5 mb-6">
          <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm border-l-4 border-l-blue-500">
            <h3 class="text-slate-500 dark:text-slate-400 text-[11px] font-bold mb-1 uppercase">Total Views</h3>
            <p class="text-2xl font-bold text-slate-800 dark:text-white" id="dash-overview-views">0</p>
          </div>
          <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm border-l-4 border-l-cyan-500">
            <h3 class="text-slate-500 dark:text-slate-400 text-[11px] font-bold mb-1 uppercase">Reached Audience</h3>
            <p class="text-2xl font-bold text-slate-800 dark:text-white" id="dash-overview-reach">0</p>
          </div>
          <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm border-l-4 border-l-emerald-500">
            <h3 class="text-slate-500 dark:text-slate-400 text-[11px] font-bold mb-1 uppercase">Avg Engagement</h3>
            <p class="text-2xl font-bold text-emerald-600" id="dash-overview-er">0%</p>
          </div>
          <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm border-l-4 border-l-purple-500">
            <h3 class="text-slate-500 dark:text-slate-400 text-[11px] font-bold mb-1 uppercase">New Followers</h3>
            <p class="text-2xl font-bold text-purple-600" id="dash-overview-followers">0</p>
          </div>
          <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm border-l-4 border-l-indigo-500">
            <h3 class="text-slate-500 dark:text-slate-400 text-[11px] font-bold mb-1 uppercase">Net Growth</h3>
            <p class="text-2xl font-bold text-indigo-600" id="dash-overview-netgrowth">0</p>
          </div>
          <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm border-l-4 border-l-pink-500">
            <h3 class="text-slate-500 dark:text-slate-400 text-[11px] font-bold mb-1 uppercase flex items-center gap-1">Qty Video (#)</h3>
            <p class="text-2xl font-bold text-pink-600 dark:text-pink-400" id="dash-overview-qtyvideo">0</p>
            <span class="text-[10px] text-slate-400 block mt-0.5" id="dash-overview-totalvideos-sub">Judul wajib # (Total: <span id="dash-overview-totalvideos">0</span>)</span>
          </div>
          <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm border-l-4 border-l-amber-500 flex justify-between items-center">
            <div>
              <h3 class="text-slate-500 dark:text-slate-400 text-[11px] font-bold mb-1 uppercase">Active Tasks</h3>
              <p class="text-2xl font-bold text-slate-800 dark:text-white" id="dash-task-count">0</p>
            </div>
            <div class="bg-amber-100 dark:bg-amber-900/30 p-2 rounded-lg text-amber-600 dark:text-amber-400">
              <i class="fa-solid fa-list-check"></i>
            </div>
          </div>
        </div>

        <!-- KPI SECOND ROW: Video & Carousel Summary -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
          <h2 class="font-bold text-lg text-slate-700 dark:text-slate-300 flex items-center">
            <i class="fa-solid fa-layer-group mr-2 text-emerald-500"></i> Video & Carousel Summary
          </h2>
          <div class="flex items-center gap-3">
            <span class="text-xs text-slate-400 font-normal hidden md:inline">CTR (%) = (Klik Produk ÷ Impresi Produk) × 100%</span>
            <button onclick="switchTab('vc-summary')" class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline bg-blue-50 dark:bg-blue-900/30 px-3 py-1.5 rounded-lg border border-blue-200 dark:border-blue-800 transition">
              Buka Video & Carousel Summary <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </button>
          </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
          <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm border-l-4 border-l-emerald-500">
            <h3 class="text-slate-500 dark:text-slate-400 text-[11px] font-bold mb-1 uppercase tracking-wider">1. GMV</h3>
            <p class="text-xl font-bold text-emerald-600 dark:text-emerald-400" id="dash-overview-gmv">Rp 0</p>
            <span class="text-[10px] text-slate-400 block mt-0.5" id="dash-overview-gmv-sub">Direct & Indirect Video</span>
          </div>
          <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm border-l-4 border-l-indigo-500">
            <h3 class="text-slate-500 dark:text-slate-400 text-[11px] font-bold mb-1 uppercase tracking-wider">2. Pesanan SKU</h3>
            <p class="text-xl font-bold text-slate-800 dark:text-white" id="dash-overview-pesanan">0</p>
            <span class="text-[10px] text-slate-400 block mt-0.5" id="dash-overview-pesanan-sub">Total Teratribusi</span>
          </div>
          <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm border-l-4 border-l-sky-500">
            <h3 class="text-slate-500 dark:text-slate-400 text-[11px] font-bold mb-1 uppercase tracking-wider">3. Impresi Produk</h3>
            <p class="text-xl font-bold text-sky-600 dark:text-sky-400" id="dash-overview-impresi">0</p>
            <span class="text-[10px] text-slate-400 block mt-0.5">Tayangan Produk</span>
          </div>
          <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm border-l-4 border-l-amber-500">
            <h3 class="text-slate-500 dark:text-slate-400 text-[11px] font-bold mb-1 uppercase tracking-wider">4. CTR (%)</h3>
            <p class="text-xl font-bold text-amber-500" id="dash-overview-ctr">0%</p>
            <span class="text-[10px] text-slate-400 block mt-0.5" id="dash-overview-ctor">CTOR: 0%</span>
          </div>
          <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm border-l-4 border-l-blue-500">
            <h3 class="text-slate-500 dark:text-slate-400 text-[11px] font-bold mb-1 uppercase tracking-wider">5. Klik Produk</h3>
            <p class="text-xl font-bold text-blue-600 dark:text-blue-400" id="dash-overview-klik">0</p>
            <span class="text-[10px] text-slate-400 block mt-0.5">Klik Keranjang</span>
          </div>
          <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm border-l-4 border-l-rose-500">
            <h3 class="text-slate-500 dark:text-slate-400 text-[11px] font-bold mb-1 uppercase tracking-wider">Top GPM (Rev/1k Views)</h3>
            <p class="text-xl font-bold text-rose-500" id="dash-overview-gpm">Rp 0</p>
            <span class="text-[10px] text-slate-400 block mt-0.5">Efisiensi Revenue</span>
          </div>
        </div>

        <!-- CONTENT PILLAR BREAKDOWN -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm mb-8">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-2">
            <div>
              <h3 class="font-bold text-lg text-slate-800 dark:text-white flex items-center">
                <i class="fa-solid fa-cubes text-blue-500 mr-2"></i> Content Pillar Intelligence (Kategori Konten)
              </h3>
              <p class="text-xs text-slate-500 mt-0.5">Analisis pilar mana yang paling mendorong views vs pilar yang paling menghasilkan penjualan.</p>
            </div>
            <span class="text-xs bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 px-3 py-1.5 rounded-lg font-semibold">
              Automated Pillar AI Tagging
            </span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4" id="pillar-cards-container">
            <!-- Populated via JS -->
          </div>
        </div>

        <!-- KPI TARGET TRACKER -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm mb-8">
          <div class="flex justify-between items-center mb-6">
             <div>
               <h3 class="font-bold text-lg text-slate-800 dark:text-white flex items-center"><i class="fa-solid fa-bullseye mr-2 text-rose-500"></i> Monthly KPI Targets</h3>
               <p class="text-xs text-slate-500 mt-0.5">Rumus CTR (%) = (Jumlah Klik Produk ÷ Jumlah Impresi Produk) × 100%</p>
             </div>
             <button onclick="openTargetModal()" class="text-xs bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 px-4 py-2 rounded-lg transition font-semibold shadow-sm"><i class="fa-solid fa-pen mr-1"></i> Edit Targets</button>
          </div>
          <div class="space-y-5">
             <div>
                <div class="flex justify-between text-sm mb-1.5"><span class="font-semibold text-slate-600 dark:text-slate-400">Target GMV Bulanan</span><span id="kpi-gmv-text" class="font-bold text-emerald-600">Rp 0 / Rp 0 (0%)</span></div>
                <div class="w-full bg-slate-100 dark:bg-slate-700 rounded-full h-3 overflow-hidden shadow-inner"><div id="kpi-gmv-bar" class="bg-emerald-500 h-3 rounded-full transition-all duration-1000 ease-out" style="width: 0%"></div></div>
             </div>
             <div>
                <div class="flex justify-between text-sm mb-1.5"><span class="font-semibold text-slate-600 dark:text-slate-400">Target Video Views</span><span id="kpi-views-text" class="font-bold text-blue-600">0 / 0 (0%)</span></div>
                <div class="w-full bg-slate-100 dark:bg-slate-700 rounded-full h-3 overflow-hidden shadow-inner"><div id="kpi-views-bar" class="bg-blue-500 h-3 rounded-full transition-all duration-1000 ease-out" style="width: 0%"></div></div>
             </div>
             <div>
                <div class="flex justify-between text-sm mb-1.5"><span class="font-semibold text-slate-600 dark:text-slate-400">Target CTR Produk (%) <span class="text-xs font-normal text-slate-400" id="kpi-ctr-detail">(0 Klik ÷ 0 Impresi)</span></span><span id="kpi-ctr-text" class="font-bold text-amber-500">0% / 0% (0%)</span></div>
                <div class="w-full bg-slate-100 dark:bg-slate-700 rounded-full h-3 overflow-hidden shadow-inner"><div id="kpi-ctr-bar" class="bg-amber-500 h-3 rounded-full transition-all duration-1000 ease-out" style="width: 0%"></div></div>
             </div>
