    function getDeltaHtml(valA, valB, isEr = false) {
      if (valB === 0 && valA === 0) return '<span class="text-slate-400 font-medium">-</span>';
      let delta, formattedDelta;
      if (isEr) {
        delta = valA - valB;
        formattedDelta = (delta > 0 ? '+' : '') + delta.toFixed(2) + '%';
      } else {
        if (valB === 0) return '<span class="text-emerald-500 font-bold"><i class="fa-solid fa-arrow-up"></i> 100%</span>';
        delta = ((valA - valB) / valB) * 100;
        formattedDelta = (delta > 0 ? '+' : '') + delta.toFixed(2) + '%';
      }
      let icon = delta > 0 ? '<i class="fa-solid fa-arrow-trend-up"></i>' : delta < 0 ? '<i class="fa-solid fa-arrow-trend-down"></i>' : '';
      let color = delta > 0 ? 'text-emerald-500' : delta < 0 ? 'text-rose-500' : 'text-slate-400';
      if (delta === 0) color = 'text-slate-500 dark:text-slate-400';
      return `<span class="${color} font-bold">${icon} ${formattedDelta}</span>`;
    }

    function formatShortDate(dateStr) {
      if (!dateStr) return '';
      const d = new Date(dateStr);
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Ags', 'Sep', 'Okt', 'Nov', 'Des'];
      return `${d.getDate()} ${months[d.getMonth()]}`;
    }

    function getAggregatedData(startDate, endDate) {
      let agg = { gmv: 0, order: 0, views: 0, reach: 0, erSum: 0, erCount: 0, impresi: 0, klik: 0, qtyVideoHashtag: 0 };
      if (!startDate || !endDate) return agg;

      const start = new Date(startDate); start.setHours(0, 0, 0, 0);
      const end = new Date(endDate); end.setHours(23, 59, 59, 999);

      Object.keys(db.daily).forEach(dateStr => {
        const currentDate = new Date(dateStr);
        if (currentDate >= start && currentDate <= end) {
          const day = db.daily[dateStr];
          let v = 0;
          if (day.sales) {
            agg.gmv += day.sales.tGmvTotal || 0;
            agg.order += day.sales.tOrder || 0;
            agg.impresi += day.sales.tProdView || 0;
            agg.klik += day.sales.tClick || 0;
            v = day.sales.tVV || 0;
          }
          if (day.overview) {
            if (v === 0) v = day.overview.views || 0;
            agg.reach += day.overview.reach || 0;
            if (day.overview.er && Number(day.overview.er) > 0) {
              agg.erSum += Number(day.overview.er);
              agg.erCount++;
            }
          }
          agg.views += v;
        }
      });

      const sourceVideos = (db.videoList && db.videoList.length > 0) ? db.videoList : (db.salesVideos || []);
      sourceVideos.forEach(v => {
        if (v.date && String(v.title || '').includes('#')) {
          const vd = new Date(v.date);
          if (vd >= start && vd <= end) {
            agg.qtyVideoHashtag++;
          }
        }
      });

      return agg;
    }

