          }
        });

        if (parsedVideos.length > 0) {
          db.videoList = parsedVideos;
        }
      }

      saveToStorage();
      if (type === 'video') {
        const hashCount = (db.videoList || []).filter(v => String(v.title || '').includes('#')).length;
